<Window x:Class="SuiteRedes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suíte de Redes — rotas ao vivo" Icon="pack://application:,,,/app.ico" Width="1440" Height="900" MinWidth="1180" MinHeight="700"
        Background="{StaticResource BgApp}" Foreground="{StaticResource T1}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <!-- Barra superior -->
    <Border Grid.ColumnSpan="2" Background="{StaticResource BgSide}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,12">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <ToggleButton x:Name="BtnCfg" Content="Destinos" Style="{StaticResource TogBtn}" Padding="16,8" Margin="0,0,8,0" ToolTip="Editar a lista de destinos testados"/>
          <Button x:Name="BtnExport" Content="Exportar relatório" Style="{StaticResource Secondary}" Padding="16,8" Margin="0,0,8,0" Click="BtnExport_Click" IsEnabled="False" ToolTip="Salvar relatório HTML (para leitura) ou CSV (amostras brutas)"/>
          <Button x:Name="BtnRun" Content="Iniciar teste" Style="{StaticResource Big}" Margin="0" Click="BtnRun_Click" ToolTip="Atalho: F5"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Suíte de Redes" FontFamily="{StaticResource Num}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="{StaticResource T3}" Margin="18,2,8,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="TxtStatus" Text="Parado. Clique em “Iniciar teste” para traçar e acompanhar as rotas." Foreground="{StaticResource T2}" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Popup x:Name="PopCfg" PlacementTarget="{Binding ElementName=BtnCfg}" Placement="Bottom" HorizontalOffset="-380" StaysOpen="False" AllowsTransparency="True"
           IsOpen="{Binding IsChecked, ElementName=BtnCfg, Mode=TwoWay}" Closed="PopCfg_Closed">
      <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="18" Width="480" Margin="0,6,0,0">
        <StackPanel>
          <TextBlock Text="Destinos testados" FontFamily="{StaticResource Num}" FontSize="17"/>
          <TextBlock Foreground="{StaticResource T3}" TextWrapping="Wrap" Margin="0,4,0,8" Text="Um por linha, até 16. Para dar um nome, use “host = nome”. Vale no próximo teste."/>
          <TextBox x:Name="TxtDests" AcceptsReturn="True" TextWrapping="NoWrap" Height="320" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" Margin="0" VerticalContentAlignment="Top"/>
          <Button Content="Restaurar lista padrão" Style="{StaticResource Secondary}" Click="BtnCfgReset_Click" HorizontalAlignment="Left" Padding="12,6" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>
    </Popup>

    <!-- Lista de destinos (ordenada: problemas primeiro) -->
    <Border Grid.Row="1" Background="{StaticResource BgSide}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,16,16,14">
          <StackPanel>
            <TextBlock Text="Sua conexão" Foreground="{StaticResource T3}" FontSize="12"/>
            <TextBlock x:Name="TxtPubIp" Text="—" FontFamily="{StaticResource Num}" FontSize="22" Margin="0,2,0,0" ToolTip="Endereço com que sua rede aparece na internet"/>
            <TextBlock x:Name="TxtPubIsp" Text="Inicie o teste para identificar o provedor." Foreground="{StaticResource T2}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            <TextBlock x:Name="TxtPubMore" Foreground="{StaticResource T3}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </Border>
        <Border x:Name="HealthEntry" DockPanel.Dock="Top" Cursor="Hand" BorderThickness="3,0,0,0" Padding="19,12,16,12" MouseLeftButtonUp="Health_Click" ToolTip="Ver o diagnóstico da rede local">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Ellipse x:Name="HealthDot" Width="8" Height="8" Fill="{StaticResource T3}" VerticalAlignment="Top" Margin="0,6,0,0"/>
            <StackPanel Grid.Column="1" Margin="4,0,0,0">
              <TextBlock Text="Diagnóstico da rede local" FontWeight="SemiBold"/>
              <TextBlock x:Name="TxtHealthSub" Text="Inicie o teste para analisar" FontSize="12" Foreground="{StaticResource T3}" Margin="0,1,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
        <TextBlock x:Name="TxtSummary" DockPanel.Dock="Top" Margin="22,14,16,10" FontSize="13" Foreground="{StaticResource T3}" TextWrapping="Wrap" Text="Nenhum teste em andamento."/>
        <ListBox x:Name="LstRoutes" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="LstRoutes_SelectionChanged">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent" Padding="19,10,16,10">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#1A1C22"/></Trigger>
                      <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource BgCard2}"/><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" Fill="{Binding StateBrush}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                <StackPanel Grid.Column="1" Margin="4,0,10,0">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{Binding SubBrush}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding Ms}" FontFamily="{StaticResource Num}" FontSize="16" Foreground="{Binding MsBrush}" HorizontalAlignment="Right"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Rota selecionada: veredito no topo; topologia ocupa o espaço livre; cartões com altura fixa embaixo -->
    <Grid Grid.Row="1" Grid.Column="1" Margin="32,22,28,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel x:Name="PnlEmpty" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
        <TextBlock Text="Veja onde a conexão falha, ponto a ponto." FontFamily="{StaticResource Num}" FontSize="26" TextWrapping="Wrap" TextAlignment="Center"/>
        <TextBlock Foreground="{StaticResource T2}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" FontSize="14"
                   Text="Clique em “Iniciar teste”. Cada destino vira um caminho ao vivo, com o IP, a rede e a latência de cada ponto."/>
      </StackPanel>

      <!-- Cabeçalho -->
      <Grid x:Name="PnlHead" Visibility="Collapsed" Margin="0,0,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="TxtDest" FontFamily="{StaticResource Num}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="TxtDestSub" Foreground="{StaticResource T3}" Margin="0,2,0,0" TextWrapping="Wrap"/>
          <Border x:Name="VerdictBox" CornerRadius="8" Padding="14,9" Margin="0,10,0,0" HorizontalAlignment="Left" MaxWidth="760">
            <DockPanel>
              <Border x:Name="VerdictIcon" Width="22" Height="22" CornerRadius="11" Margin="0,0,12,0" VerticalAlignment="Top">
                <TextBlock x:Name="TxtVerdictIcon" FontWeight="Bold" FontSize="13" Foreground="#16181D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="TxtVerdict" FontSize="15" TextWrapping="Wrap" Foreground="{StaticResource T1}" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
        </StackPanel>
        <StackPanel x:Name="PnlStats" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"/>
      </Grid>

      <ScrollViewer x:Name="PnlHealthBody" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="HealthList" MaxWidth="900" HorizontalAlignment="Left"/>
      </ScrollViewer>
      <Grid x:Name="PnlBody" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*" MinHeight="200" MaxHeight="330"/><RowDefinition Height="2*" MinHeight="185"/></Grid.RowDefinitions>
        <!-- Topologia ao vivo -->
        <StackPanel Margin="0,0,0,8">
          <TextBlock Text="Topologia ao vivo" Foreground="{StaticResource T2}" FontWeight="SemiBold"/>
          <WrapPanel x:Name="TopoLegend" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource CardEdge}" BorderThickness="1" CornerRadius="10" Padding="0">
          <ScrollViewer x:Name="TopoScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" SizeChanged="TopoScroll_SizeChanged">
            <Canvas x:Name="TopoCanvas" Height="250" HorizontalAlignment="Left" VerticalAlignment="Top"/>
          </ScrollViewer>
        </Border>
        <!-- Cartões do ponto selecionado -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="4*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>
          <!-- Onde o tempo é gasto -->
          <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource CardEdge}" BorderThickness="1" CornerRadius="10" Padding="20,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock Text="Onde o tempo é gasto até o destino" Foreground="{StaticResource T3}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                <Canvas x:Name="SpendCanvas" Height="40"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <!-- Radar -->
          <Border Grid.Column="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource CardEdge}" BorderThickness="1" CornerRadius="10" Padding="16,14">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Radar: últimas 120 medições" Foreground="{StaticResource T3}" TextWrapping="Wrap" ToolTip="Cerca de 2 minutos, uma medição por segundo"/>
              <TextBlock x:Name="TxtRadarLegend" DockPanel.Dock="Bottom" Foreground="{StaticResource T3}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
              <Canvas x:Name="RadarCanvas" ClipToBounds="True"/>
            </DockPanel>
          </Border>
          <!-- Disponibilidade + ocorrências -->
          <Border Grid.Column="4" Background="{StaticResource BgCard}" BorderBrush="{StaticResource CardEdge}" BorderThickness="1" CornerRadius="10" Padding="16,14">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" Foreground="{StaticResource T3}">Ocorrências <Run x:Name="TxtEvCount"/></TextBlock>
              <TextBlock x:Name="TxtNoEv" DockPanel.Dock="Top" Text="Nenhuma ocorrência até agora." Foreground="{StaticResource T3}" FontSize="13"/>
              <ItemsControl x:Name="LstEvents">
                <ItemsControl.Template><ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,2">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding TimeTxt}" FontFamily="{StaticResource Num}" Foreground="{StaticResource T3}" FontSize="12"/>
                      <Ellipse Grid.Column="1" Width="6" Height="6" Fill="{Binding Brush}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                      <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="{StaticResource T2}" TextWrapping="Wrap" FontSize="12" Margin="4,0,0,0"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
