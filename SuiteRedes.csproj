<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework 4.7.2: já vem no Windows 10 (1803+), Windows 11 e Windows Server 2019/2022/2025.
       Nada é embutido: o executável usa o Framework do próprio Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SuiteRedes</RootNamespace>
    <AssemblyName>SuiteRedes</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>

    <!-- Metadados completos: executáveis sem empresa/copyright/descrição pontuam como suspeitos na heurística dos antivírus -->
    <Company>Skytins</Company>
    <Copyright>© 2026 Skytins</Copyright>
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <Deterministic>true</Deterministic>
    <Optimize>true</Optimize>
    <Product>Suíte de Redes</Product>
    <AssemblyTitle>Suíte de Redes - análise de rotas ao vivo</AssemblyTitle>
    <Description>Análise de rotas em tempo real, diagnóstico da rede local e relatórios.</Description>
    <Version>2.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <InformationalVersion>2.0.0</InformationalVersion>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Web" />
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
    <Resource Include="app.ico" />
    <Compile Remove="_legacy/**" />
    <Page Remove="_legacy/**" />
    <None Remove="_legacy/**" />
  </ItemGroup>
</Project>
